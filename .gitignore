# ─────────────────────────────────────────────────────────────────────────────
# .gitignore — ehsankolivand.github.io (public site)
# The site is built by a Python generator and deployed via GitHub Actions.
# Generated output is NEVER committed (Principle IV) — only source is tracked.
# ─────────────────────────────────────────────────────────────────────────────

# Internal working material — not part of the public site
research/

# Private, local-only docs — never committed, never served (visible only on your machine)
readme.html
bug-audit-resolution-report.html

# Plugin integration spec — local extraction artifact for the separate Obsidian-plugin project; never pushed
PLUGIN_INTEGRATION_SPEC.md

# ── Build artifacts (generated by the static-site generator) ─────────────────
# The assembled, deployable site — built into _site/ by scripts/build_blog.py;
# never committed (Principle IV), GitHub Actions rebuilds it on every push.
_site/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
# Packaging / tooling caches (none committed; here so they never sneak in)
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
# Local virtual environments
.venv/
venv/
env/
ENV/

# ── Node (only if tooling is ever added — none committed today) ───────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Environment / secrets — never commit credentials or local overrides ───────
.env
.env.*
*.local

# ── Obsidian vault config — never commit to the public repo (any location) ────
# Generalizes the former content/blog/.obsidian/ rule to catch the vault config
# wherever it lives (e.g. content/.obsidian/, content/blog/.obsidian/).
.obsidian/

# ── macOS / Windows / editor cruft ───────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
*.log
*.tmp
*.swp
*.swo
*~

# Editors / IDEs
.vscode/
.idea/
