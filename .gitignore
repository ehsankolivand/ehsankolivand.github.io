# Internal working material — not part of the public site
research/

# Private, local-only docs — never committed, never served (visible only on your machine)
readme.html

# macOS / editor cruft
.DS_Store
*.log
*.tmp
*.swp

# Generated build artifact (the assembled, deployable site) — never committed (Principle IV)
_site/

# Python
__pycache__/
*.pyc

# Plugin integration spec — local extraction artifact for the separate Obsidian-plugin project; never pushed
PLUGIN_INTEGRATION_SPEC.md

# Obsidian vault config living inside the content folder — never commit to the public repo
content/blog/.obsidian/
